local AuxFilter = {}

-- local log = require 'log'
-- log.outfile = "aux_code.log"

-- local MyLogFile = io.open("/sdcard/Android/data/org.fcitx.fcitx5.android/files/data/rime/lua/aux_code.log", "a+")
-- local function MyLog(content)
--     MyLogFile:write(content .. "\n")
--     MyLogFile:flush()
-- end
local function MyLog(content)
end

local function escape_class_char(c)
    if c == "]" or c == "^" or c == "-" or c == "%" or c == "\\" then
        return "%" .. c
    end
    return c
end

function IsWindows()
   return false
end

function AuxFilter.init(env)
    -- log.info("** AuxCode filter", env.name_space)

    AuxFilter.aux_code = require('aux_code_data')
    -- 补充反转辅助码：若辅助码为两个字符，则反转后也是合法辅助码
    -- （预编译数据不含反转，加载后在此补充；列表内去重）
    for _, codes in pairs(AuxFilter.aux_code) do
        for i = 1, #codes do
            local code = codes[i]
            if #code == 2 then
                local reversed = code:sub(2, 2) .. code:sub(1, 1)
                if reversed ~= code then
                    local dup = false
                    for j = 1, #codes do
                        if codes[j] == reversed then dup = true; break end
                    end
                    if not dup then table.insert(codes, reversed) end
                end
            end
        end
    end

    local engine = env.engine
    local config = engine.schema.config

    -- 設定預設觸發鍵為分號，並從配置中讀取自訂的觸發鍵
    env.trigger_key = config:get_string("key_binder/aux_code_trigger") or "\'"
    -- 第二個觸發鍵：等價於 trigger_key，但會附加開啟 exact_mode
    env.exact_trigger_key = "!"
    env.strict_mode = env.name_space == "strict"
    -- 構造同時匹配兩種分隔符的 Lua 字符類
    env.trigger_class = "[" .. escape_class_char(env.trigger_key) ..
                        escape_class_char(env.exact_trigger_key) .. "]"
    -- 设定是否显示辅助码，默认为显示
    env.show_aux_notice = config:get_string("key_binder/show_aux_notice") or 'true'
    if env.show_aux_notice == "false" then
        env.show_aux_notice = false
    else
        env.show_aux_notice = true
    end

    ----------------------------
    -- 持續選詞上屏，保持輔助碼分隔符存在 --
    ----------------------------
    env.notifier = engine.context.select_notifier:connect(function(ctx)
        local trigger_pos = ctx.input:find(env.trigger_class)
        -- 續輸時保留用戶原本使用的分隔符
        local trigger_char = trigger_pos and ctx.input:sub(trigger_pos, trigger_pos) or env.trigger_key

        -- 含有輔助碼分隔符才處理
        if not trigger_pos and #ctx.input % 2 == 0 then
            return
        end

        local preedit = ctx:get_preedit()
        local removeAuxInput = ""
        local reeditTextFront = ""
        if trigger_pos then
            removeAuxInput = ctx.input:match("([^,]+)" .. env.trigger_class)
            MyLog(string.format("removeAuxInput~~~:%s", removeAuxInput))
            reeditTextFront = preedit.text:match("([^,]+)" .. env.trigger_class)
        else
            removeAuxInput = string.sub(ctx.input, 1, #ctx.input - 1)
            MyLog(string.format("before reeditTextFront:%s", preedit.text))
            if IsWindows() then
                reeditTextFront = string.sub(preedit.text, 1, #preedit.text - 4)
            else
                reeditTextFront = string.sub(preedit.text, 1, #preedit.text - 1)
            end
            MyLog(string.format("removeAuxInput:%s", removeAuxInput))
            MyLog(string.format("after reeditTextFront:%s", reeditTextFront))
        end
        -- ctx.text 隨著選字的進行，oaoaoa； 有如下的輸出：
        -- ---- 有輔助碼 ----
        -- >>> 啊 oaoa；au
        -- >>> 啊吖 oa；au
        -- >>> 啊吖啊；au
        -- ---- 無輔助碼 ----
        -- >>> 啊 oaoa；
        -- >>> 啊吖 oa；
        -- >>> 啊吖啊；
        -- 這邊把已經上屏的字段 (preedit:text) 進行分割；
        -- 如果已經全部選完了，分割後的結果就是 nil，否則都是 吖卡 a 這種字符串
        -- 驗證方式：
        -- log.info('select_notifier', ctx.input, removeAuxInput, preedit.text, reeditTextFront)

        ctx.input = removeAuxInput
        if reeditTextFront and reeditTextFront:match("[a-z]") then
            ctx.input = ctx.input .. trigger_char
        else
            ctx:commit()
        end
    end)
end

----------------
-- 閱讀輔碼文件 --
----------------
function AuxFilter.readAuxTxt(txtpath)
    -- log.info("** AuxCode filter", 'read Aux code txt:', txtpath)

    local defaultFile = 'ZRM_Aux-code_4.3.txt'
    local userPath = rime_api.get_user_data_dir() .. "/lua/"
    local fileAbsolutePath = userPath .. txtpath .. ".txt"

    local file = io.open(fileAbsolutePath, "r") or io.open(userPath .. defaultFile, "r")
    if not file then
        error("Unable to open auxiliary code file.")
        return {}
    end

    local auxCodes = {}
    local function insert_unique(codeList, code)
        for _, existing in ipairs(codeList) do
            if existing == code then
                return
            end
        end
        table.insert(codeList, code)
    end

    for line in file:lines() do
        line = line:match("[^\r\n]+") -- 去掉換行符，不然 value 是帶著 \n 的
        local key, value = line:match("([^=]+)=(.+)") -- 分割 = 左右的變數
        if key and value then
            auxCodes[key] = auxCodes[key] or {}
            insert_unique(auxCodes[key], value)

            if #value == 2 then
                local reversed = value:sub(2, 2) .. value:sub(1, 1)
                insert_unique(auxCodes[key], reversed)
            end
        end
    end
    file:close()
    -- 確認 code 能打印出來
    -- for key, value in pairs(AuxFilter.aux_code) do
    --     log.info(key, table.concat(value, ','))
    -- end

    return auxCodes
end

