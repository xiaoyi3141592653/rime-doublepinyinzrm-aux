local DEBUG = false     -- 设为 true 开启调试，false 关闭调试
local PERF_DEBUG = false -- 设为 true 开启性能调试，false 关闭性能调试

local MyLog, MyFormat, PerfLog
if DEBUG or PERF_DEBUG then
    MyFormat = string.format
else
    MyFormat = function() return "" end
end

local sp_map = require("hanzi_shuangpin_data")

if DEBUG then
    local MyLogFile = io.open("/sdcard/Android/data/org.fcitx.fcitx5.android/files/data/rime/lua/adjacent_corrector.log",
        "a+")
    MyLog = function(s)
        MyLogFile:write(s .. "\n")
        MyLogFile:flush()
    end
else
    -- 生产环境：空实现，避免任何性能开销
    MyLog = function() end
end

if PERF_DEBUG then
    local PerfLogFile = io.open(
        "/sdcard/Android/data/org.fcitx.fcitx5.android/files/data/rime/lua/adjacent_corrector_perf.log",
        "a+")
    PerfLog = function(s)
        local timestamp = os.clock() * 1000 -- 毫秒时间戳
        PerfLogFile:write(string.format("[%.3fms] %s\n", timestamp, s))
        PerfLogFile:flush()
    end
else
    -- 生产环境：空实现，避免任何性能开销
    PerfLog = function() end
end

-- 性能计时器
local perf_timers = {}
local function start_timer(name)
    if PERF_DEBUG then
        perf_timers[name] = os.clock()
    end
end

local function end_timer(name)
    if PERF_DEBUG and perf_timers[name] then
        local elapsed = (os.clock() - perf_timers[name]) * 1000 -- 转换为毫秒
        PerfLog(string.format("TIMER [%s] took %.3fms", name, elapsed))
        perf_timers[name] = nil
        return elapsed
    end
    return 0
end
MyLog("=== adjacent_corrector.lua loaded (hanzi_shuangpin) ===")
PerfLog("=== adjacent_corrector.lua loaded - performance monitoring started ===")

local M = {}

-- 取脚本目录
local function get_script_dir()
    local userPath = rime_api.get_user_data_dir() .. "/lua/"
    return userPath
end

-- UTF-8 按字遍历
local function utf8_iter(str)
    return tostring(str):gmatch("[\1-\127\194-\244][\128-\191]*")
end


local function get_ch_sp(ch, env)
    start_timer("get_ch_sp")
    local map = sp_map
    local codes = map[ch]
    if not codes or #codes == 0 then
        end_timer("get_ch_sp")
        return nil
    end
    end_timer("get_ch_sp")
    return codes
end

-- 候选词转双拼（逐字拼接，支持多读音）；返回该词可能的所有拼接结果列表；若任一字缺码返回 nil
local function word_to_sp(word, env)
    start_timer("word_to_sp_total")
    local word_len = 0
    for _ in utf8_iter(word) do word_len = word_len + 1 end
    PerfLog(string.format("word_to_sp processing word: %s (length: %d)", word, word_len))

    start_timer("word_to_sp_get_codes")
    local per_char_codes = {}
    for ch in utf8_iter(word) do
        local codes = get_ch_sp(ch, env)
        if not codes or #codes == 0 then
            end_timer("word_to_sp_get_codes")
            end_timer("word_to_sp_total")
            return nil
        end
        per_char_codes[#per_char_codes + 1] = codes
    end
    end_timer("word_to_sp_get_codes")

    -- 笛卡尔拼接
    start_timer("word_to_sp_cartesian")
    local results = { "" }
    local combinations_count = 1
    for i = 1, #per_char_codes do
        combinations_count = combinations_count * #per_char_codes[i]
    end
    PerfLog(string.format("word_to_sp cartesian combinations: %d", combinations_count))

    for i = 1, #per_char_codes do
        local next_results = {}
        for _, prefix in ipairs(results) do
            for _, code in ipairs(per_char_codes[i]) do
                next_results[#next_results + 1] = prefix .. code
            end
        end
        results = next_results
    end
    end_timer("word_to_sp_cartesian")

    MyLog(MyFormat("word_to_sp: %s -> %s", word, table.concat(results, ",")))
    PerfLog(string.format("word_to_sp result count: %d", #results))
    end_timer("word_to_sp_total")
    return results
end

-- 规范化输入串
-- 1) 若包含 ' 或 !，只取其前（! 同时是 exact_mode 触发符）
-- 2) 否则若长度>1且为奇数，去掉最后一个
local function normalize_input(raw)
    local s = raw or ""
    local i = s:find("['!]")
    if i then
        return s:sub(1, i - 1)
    end
    if #s > 1 and (#s % 2 == 1) then
        return s:sub(1, #s - 1)
    end
    return s
end

-- 加载映射：每行「汉字 空格 双拼」，同字多读音全部保留为数组
-- 注意: 此函数已废弃，现在通过 require("hanzi_shuangpin_data") 直接加载
--[[
